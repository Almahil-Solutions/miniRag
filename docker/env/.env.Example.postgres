# ============================================================
# miniRAG — PostgreSQL Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.postgres (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
#
# WARNING: The application startup validator will HARD-FAIL if
# POSTGRES_PASSWORD is set to the placeholder 'postgres_password'.
# ============================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME>  # REQUIRED — no default accepted
POSTGRES_DB=minirag