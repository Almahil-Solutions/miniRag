# ============================================================
# miniRAG — RabbitMQ Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.rabbitmq (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
#
# WARNING: The application startup validator will HARD-FAIL if
# 'minirag_rabbitmq' is detected in CELERY_BROKER_URL.
# ============================================================

RABBITMQ_DEFAULT_USER=minirag_user
RABBITMQ_DEFAULT_PASS=<CHANGE_ME>    # REQUIRED — no default accepted
RABBITMQ_DEFAULT_VHOST=minirag_vhost

# Management Plugin
RABBITMQ_MANAGEMENT_ENABLED=true

# Security
RABBITMQ_AUTH_BACKENDS=rabbit_auth_backend_internal

# Performance
RABBITMQ_DISK_FREE_LIMIT=2000000000