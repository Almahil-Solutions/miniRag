# ============================================================
# miniRAG — PostgreSQL Exporter Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.postgres-exporter (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
# ============================================================

# Full DSN (URI form) — set the password to the same value as
# POSTGRES_PASSWORD in .env.postgres.
DATA_SOURCE_URI=pgvector:5432/postgres?sslmode=disable
DATA_SOURCE_USER=postgres
DATA_SOURCE_PASSWORD=<CHANGE_ME>  # REQUIRED — must match POSTGRES_PASSWORD
