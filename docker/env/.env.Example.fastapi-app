# ============================================================
# miniRAG — FastAPI App Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.fastapi-app (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
#      Only .env.Example.* files belong in the repository.
#
# WARNING: The application startup validator will HARD-FAIL if
# it detects any of the known placeholder passwords below:
#   - minirag_redis, minirag_rabbitmq, your_api_key_here,
#     your_password, postgres_password, admin_password
# ============================================================

APP_NAME="mini-RAG"
APP_VERSION="0.3"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=50 # in MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 KB

# ── Database ─────────────────────────────────────────────────
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="<CHANGE_ME>"          # REQUIRED — no default accepted
POSTGRES_HOST="pgvector"
POSTGRES_PORT=5400
POSTGRES_MAIN_DATABASE="minirag"

# ── LLM Config ───────────────────────────────────────────────
GENERATION_BACKEND_LITERAL=["COHERE", "OPENAI"]
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY="<CHANGE_ME>"             # REQUIRED if GENERATION_BACKEND=OPENAI
OPENAI_API_URL=
COHERE_API_KEY="<CHANGE_ME>"             # REQUIRED if EMBEDDING_BACKEND=COHERE

GENERATION_MODEL_ID="gpt-4o-mini-2024-07-18"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ── Vector DB Config ─────────────────────────────────────────
VECTOR_DB_BACKEND_LITERAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# ── Template configs ─────────────────────────────────────────
PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ── Celery Task Queue Config ──────────────────────────────────
# Both URLs embed passwords — replace <CHANGE_ME> with real credentials.
CELERY_BROKER_URL="amqp://minirag_user:<CHANGE_ME>@rabbitmq:5672/minirag_vhost"
CELERY_RESULT_BACKEND="redis://:<CHANGE_ME>@redis:6379/0"
CELERY_TASK_SERIALIZER="json"
CELERY_TASK_TIME_LIMIT=600           # 600 s
# true: ACK after processing; false: ACK on receipt
CELERY_TASK_ACKS_LATE=false
CELERY_WORKER_CONCURRENCY=2
CELERY_FLOWER_PASSWORD="<CHANGE_ME>"  # REQUIRED — no default accepted
CELERY_TASK_CLEANUP_RETENTION=86400  # 24 H
