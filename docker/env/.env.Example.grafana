# ============================================================
# miniRAG — Grafana Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.grafana (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
#
# WARNING: The application startup validator rejects the
# placeholder 'admin_password'.  Set a real Grafana password.
# ============================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<CHANGE_ME>  # REQUIRED — no default accepted
GF_USERS_ALLOW_SIGN_UP=false