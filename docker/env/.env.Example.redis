# ============================================================
# miniRAG — Redis Environment (EXAMPLE)
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.redis (no .Example in name).
#   2. Replace EVERY value marked <CHANGE_ME> with a real secret.
#   3. NEVER commit real .env files to version control.
#
# WARNING: The docker-compose Redis command uses ${REDIS_PASSWORD}
# with NO fallback.  If this variable is unset or empty, Redis
# will fail to start.  This is intentional — it prevents
# accidental deployment with no authentication.
#
# The application startup validator will also HARD-FAIL if
# 'minirag_redis' is detected in CELERY_RESULT_BACKEND.
# ============================================================

# REQUIRED — replace with a strong, randomly generated password
REDIS_PASSWORD=<CHANGE_ME>

# Persistence
REDIS_APPENDONLY=yes

# Memory Management
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Security
REDIS_PROTECTED_MODE=yes