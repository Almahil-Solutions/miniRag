.vscode

# ── Secrets: Real environment files ──────────────────────────────────────────
# Only .env.Example.* files should be committed.
# Real .env files contain secrets and MUST NEVER be committed.
docker/env/.env.*
!docker/env/.env.Example.*

# Also exclude root-level .env files (e.g., from local dev setups)
.env
.env.*
!.env.example
!.env.Example

